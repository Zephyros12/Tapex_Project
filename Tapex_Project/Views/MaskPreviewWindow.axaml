<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tapex_Project.Views.MaskPreviewWindow"
        x:CompileBindings="False"
        Title="Mask Preview" Width="900" Height="700"
        CanResize="True">

    <Viewbox Stretch="Uniform">
        <Image Source="{Binding MaskBitmap}" Opacity="0.4"/>
    </Viewbox>
</Window>
