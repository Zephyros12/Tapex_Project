<UserControl
    x:Class="Tapex_Project.Views.ImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:DataType="vm:ImageViewModel">

    <StackPanel Spacing="8">
        <Image Source="{Binding Current.FilePath}" Stretch="Uniform"/>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Load" Command="{Binding LoadCmd}" />
            <Button Content="Prev" Command="{Binding PrevCmd}" />
            <Button Content="Next" Command="{Binding NextCmd}" />
        </StackPanel>
    </StackPanel>
</UserControl>
