<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:Class="Tapex_Project.Views.ImageView"
    x:DataType="vm:ImageViewModel"
	 xmlns:ctrls="clr-namespace:Tapex_Project.Views.Controls;assembly=Tapex_Project" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 1) Load 버튼 (기존) -->
		<Button
		  Grid.Row="0"
		  Content="Load"
		  Command="{Binding LoadCmd}"
		  Margin="4"/>

		<!-- 2) 줌·팬 컨테이너 -->

		<ctrls:ZoomableImage
		  Grid.Row="1"
		  Source="{Binding Current.DisplayBitmap}"
		  ClipToBounds="True"/>
		
	</Grid>
</UserControl>
