<UserControl
    x:Class="Tapex_Project.Views.ImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:DataType="vm:ImageViewModel">

    <Grid RowDefinitions="* Auto">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding Current.DisplayBitmap}"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </ScrollViewer>
        
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <Button Content="Load" Command="{Binding LoadCmd}" />
            <Button Content="Prev" Command="{Binding PrevCmd}" />
            <Button Content="Next" Command="{Binding NextCmd}" />
        </StackPanel>
    </Grid>
</UserControl>
