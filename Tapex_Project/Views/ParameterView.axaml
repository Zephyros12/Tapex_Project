<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
    x:Class="Tapex_Project.Views.ParameterView"
    x:DataType="vm:ParameterViewModel">

    <StackPanel Margin="8" Spacing="12">
        <TextBlock
          Text="Detection Parameters"
          FontWeight="Bold"
          FontSize="16" />

        <!-- Grid 로 레이블과 입력부를 정렬하되, ColumnSpacing/RowSpacing 대신 Margin 사용 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1행: Pixel Size -->
            <TextBlock
              Grid.Row="0" Grid.Column="0"
              Text="Pixel Size (μm):"
              VerticalAlignment="Center"
              Margin="0,0,8,8"/>
            <TextBlock
              Grid.Row="0" Grid.Column="1"
              Text="{Binding Config.PixelSizeMicrometer}"
              VerticalAlignment="Center"
              Margin="0,0,0,8"/>

            <!-- 2행: Min Defect Size (mm) -->
            <TextBlock
              Grid.Row="1" Grid.Column="0"
              Text="Min Defect Size (mm):"
              VerticalAlignment="Center"
              Margin="0,0,8,8"/>
            <controls:NumericUpDown
              Grid.Row="1" Grid.Column="1"
              Minimum="0.01"
              Maximum="1000"
              Increment="0.01"
              Value="{Binding Config.MinDefectSizeMm, Mode=TwoWay}"
              HorizontalAlignment="Left"
              Margin="0,0,0,8"/>

            <!-- 3행: Brightness Threshold -->
            <TextBlock
              Grid.Row="2" Grid.Column="0"
              Text="Brightness Thr:"
              VerticalAlignment="Center"
              Margin="0,0,8,8"/>
            <controls:NumericUpDown
              Grid.Row="2" Grid.Column="1"
              Minimum="0"
              Maximum="255"
              Increment="0.1"
              Value="{Binding Config.BrightnessThreshold, Mode=TwoWay}"
              HorizontalAlignment="Left"
              Margin="0,0,0,8"/>

            <!-- 4행: Sharpness Threshold -->
            <TextBlock
              Grid.Row="3" Grid.Column="0"
              Text="Sharpness Thr:"
              VerticalAlignment="Center"
              Margin="0,0,8,0"/>
            <controls:NumericUpDown
              Grid.Row="3" Grid.Column="1"
              Minimum="0"
              Maximum="1000"
              Increment="1"
              Value="{Binding Config.SharpnessThreshold, Mode=TwoWay}"
              HorizontalAlignment="Left"
              Margin="0,0,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
