<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
    x:Class="Tapex_Project.Views.ParameterView"
    x:DataType="vm:ParameterViewModel">

    <StackPanel Margin="8" Spacing="12">
        <TextBlock
          Text="Parameters"
          FontWeight="Bold"
          FontSize="16" />

        <TabControl>
            <!-- 1) General (전역 필터) -->
            <TabItem Header="General">
                <ScrollViewer Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pixel Size (μm):" Margin="0,0,8,8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Config.PixelSizeMicrometer}" Margin="0,0,0,8" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Defect Size (mm):" Margin="0,0,8,8" VerticalAlignment="Center"/>
                        <controls:NumericUpDown
                          Grid.Row="1" Grid.Column="1"
                          Minimum="0.01" Maximum="1000" Increment="0.01"
                          Value="{Binding Config.MinDefectSizeMm, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Brightness Thr:" Margin="0,0,8,8" VerticalAlignment="Center"/>
                        <controls:NumericUpDown
                          Grid.Row="2" Grid.Column="1"
                          Minimum="0" Maximum="255" Increment="0.1"
                          Value="{Binding Config.BrightnessThreshold, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sharpness Thr:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <controls:NumericUpDown
                          Grid.Row="3" Grid.Column="1"
                          Minimum="0" Maximum="1000" Increment="1"
                          Value="{Binding Config.SharpnessThreshold, Mode=TwoWay}"
                          Width="80"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 2) Bubble 전처리 파라미터 -->
            <TabItem Header="Bubble">
                <ScrollViewer Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Morph Kernel Size:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="0" Grid.Column="1"
                          Minimum="1" Maximum="51" Increment="2"
                          Value="{Binding BubbleParams.MorphKernelSize, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Threshold:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="1" Grid.Column="1"
                          Minimum="0" Maximum="255" Increment="1"
                          Value="{Binding BubbleParams.Threshold, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Value:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="2" Grid.Column="1"
                          Minimum="0" Maximum="255" Increment="1"
                          Value="{Binding BubbleParams.MaxValue, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Area (px):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="3" Grid.Column="1"
                          Minimum="0" Maximum="10000" Increment="1"
                          Value="{Binding BubbleParams.MinArea, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Width (px):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="4" Grid.Column="1"
                          Minimum="1" Maximum="1000" Increment="1"
                          Value="{Binding BubbleParams.MinWidth, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Min Height (px):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="5" Grid.Column="1"
                          Minimum="1" Maximum="1000" Increment="1"
                          Value="{Binding BubbleParams.MinHeight, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Min Circularity:" Margin="0,0,8,0"/>
                        <controls:NumericUpDown
                          Grid.Row="6" Grid.Column="1"
                          Minimum="0" Maximum="1" Increment="0.01"
                          Value="{Binding BubbleParams.MinCircularity, Mode=TwoWay}"
                          Width="80"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 3) Dust 전처리 파라미터 -->
            <TabItem Header="Dust">
                <ScrollViewer Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="0" Grid.Column="1"
                          Minimum="0" Maximum="255" Increment="1"
                          Value="{Binding DustParams.Threshold, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Area (px):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="1" Grid.Column="1"
                          Minimum="0" Maximum="10000" Increment="1"
                          Value="{Binding DustParams.MinArea, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Area (px):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="2" Grid.Column="1"
                          Minimum="0" Maximum="10000" Increment="1"
                          Value="{Binding DustParams.MaxArea, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Morph Kernel:" Margin="0,0,8,0"/>
                        <controls:NumericUpDown
                          Grid.Row="3" Grid.Column="1"
                          Minimum="1" Maximum="51" Increment="2"
                          Value="{Binding DustParams.MorphKernel, Mode=TwoWay}"
                          Width="80"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 4) Scratch -->
            <TabItem Header="Scratch">
                <ScrollViewer Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Canny Thr1:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="0" Grid.Column="1"
                          Minimum="0" Maximum="500" Increment="1"
                          Value="{Binding ScratchParams.CannyThreshold1, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Canny Thr2:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="1" Grid.Column="1"
                          Minimum="0" Maximum="500" Increment="1"
                          Value="{Binding ScratchParams.CannyThreshold2, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dilate Kernel:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="2" Grid.Column="1"
                          Minimum="1" Maximum="31" Increment="2"
                          Value="{Binding ScratchParams.DilateKernel, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Length (mm):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="3" Grid.Column="1"
                          Minimum="0.1" Maximum="100" Increment="0.1"
                          Value="{Binding ScratchParams.MinLengthMm, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Width (px):" Margin="0,0,8,0"/>
                        <controls:NumericUpDown
                          Grid.Row="4" Grid.Column="1"
                          Minimum="1" Maximum="100" Increment="1"
                          Value="{Binding ScratchParams.MaxWidthPx, Mode=TwoWay}"
                          Width="80"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 5) Crack -->
            <TabItem Header="Crack">
                <ScrollViewer Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Canny Thr1:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="0" Grid.Column="1"
                          Minimum="0" Maximum="500" Increment="1"
                          Value="{Binding CrackParams.CannyThreshold1, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Canny Thr2:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="1" Grid.Column="1"
                          Minimum="0" Maximum="500" Increment="1"
                          Value="{Binding CrackParams.CannyThreshold2, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hough Thresh:" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="2" Grid.Column="1"
                          Minimum="1" Maximum="200" Increment="1"
                          Value="{Binding CrackParams.HoughThreshold, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Len (mm):" Margin="0,0,8,8"/>
                        <controls:NumericUpDown
                          Grid.Row="3" Grid.Column="1"
                          Minimum="0.1" Maximum="100" Increment="0.1"
                          Value="{Binding CrackParams.MinLineLengthMm, Mode=TwoWay}"
                          Width="80" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Gap (mm):" Margin="0,0,8,0"/>
                        <controls:NumericUpDown
                          Grid.Row="4" Grid.Column="1"
                          Minimum="0" Maximum="50" Increment="0.1"
                          Value="{Binding CrackParams.MaxLineGapMm, Mode=TwoWay}"
                          Width="80"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
