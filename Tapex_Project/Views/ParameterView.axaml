<UserControl
    x:Class="Tapex_Project.Views.ParameterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:DataType="vm:ParameterViewModel">

    <StackPanel Spacing="6" Margin="8">

        <!-- Adaptive Threshold -->
        <TextBlock Text="Adaptive Block Size (px, odd)" />
        <NumericUpDown Minimum="3" Maximum="199"
                       Value="{Binding Config.AdaptiveBlockSize, Mode=TwoWay}" />

        <TextBlock Text="Adaptive C" />
        <NumericUpDown Minimum="-50" Maximum="50"
                       Value="{Binding Config.AdaptiveC, Mode=TwoWay}" />

        <!-- Morphology -->
        <TextBlock Text="Morph Kernel (px)" />
        <NumericUpDown Minimum="1" Maximum="15"
                       Value="{Binding Config.MorphKernel, Mode=TwoWay}" />

        <!-- Area Filter -->
        <TextBlock Text="Min Area (mm²)" />
        <NumericUpDown Minimum="0.001" Maximum="10"
                       Increment="0.001"
                       Value="{Binding Config.MinAreaPx, Mode=TwoWay}" />

        <TextBlock Text="Max Area (mm²)" />
        <NumericUpDown Minimum="0.001" Maximum="100"
                       Increment="0.001"
                       Value="{Binding Config.MaxAreaPx, Mode=TwoWay}" />

        <!-- Shape Filter -->
        <TextBlock Text="Min Circularity (0–1)" />
        <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                Value="{Binding Config.MinCircularity, Mode=TwoWay}" />

    </StackPanel>
</UserControl>
