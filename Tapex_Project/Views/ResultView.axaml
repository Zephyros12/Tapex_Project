<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:Class="Tapex_Project.Views.ResultView"
    x:DataType="vm:ResultViewModel">


	<!-- Grid에 Spacing 속성 제거 -->
	<Grid Margin="4">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- 정렬 기준 -->
			<RowDefinition Height="Auto"/>
			<!-- 타입별 요약 -->
			<RowDefinition Height="*"/>
			<!-- 결과 리스트 (가변 높이) -->
		</Grid.RowDefinitions>

		<!-- 1) 정렬 기준 선택 -->
		<StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,8">
			<!-- 아래 여백으로 간격 -->
			<TextBlock Text="정렬 기준:" VerticalAlignment="Center"/>
			<ComboBox
                Width="120"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<!-- 2) 타입별 검출 개수 요약 -->
		<ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding TypeCounts}"
            Margin="0,0,0,8">
			<!-- 아래 여백으로 간격 -->
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" Spacing="16"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<TextBlock>
						<Run Text="{Binding Type}"/>
						<Run Text=": "/>
						<Run Text="{Binding Count}"/>
					</TextBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- 3) 정렬된 결과 리스트 -->
		<ListBox
            Grid.Row="2"
            ItemsSource="{Binding Results}"
            SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
            VerticalAlignment="Stretch"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />
	</Grid>
</UserControl>