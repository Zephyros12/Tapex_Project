<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:Class="Tapex_Project.Views.ResultView"
    x:DataType="vm:ResultViewModel">

    <ListBox ItemsSource="{Binding Results}" Margin="4">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Type}" />
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>