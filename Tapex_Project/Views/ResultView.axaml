<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:Class="Tapex_Project.Views.ResultView"
    x:DataType="vm:ResultViewModel">

    <StackPanel Spacing="8" Margin="4">
        <!-- 1) 정렬 기준 선택 -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="정렬 기준:" VerticalAlignment="Center"/>
            <ComboBox
              Width="120"
              ItemsSource="{Binding SortOptions}"
              SelectedItem="{Binding SelectedSort}" />
        </StackPanel>

        <!-- 2) 타입별 검출 개수 요약 -->
        <ItemsControl ItemsSource="{Binding TypeCounts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Type}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Count}"/>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 3) 정렬된 결과 리스트 -->
        <ListBox
      ItemsSource="{Binding Results}"
      SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
      Height="200"
      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Type}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>