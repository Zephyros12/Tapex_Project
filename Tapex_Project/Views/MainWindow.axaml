<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Tapex_Project.Views"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:Class="Tapex_Project.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="Tapex Project"
    Width="1024" Height="768">

    <Grid ColumnDefinitions="2*,1*">
        <!-- 좌측: Load 버튼 + 이미지/ROI -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <!-- 1) Load 버튼 -->
            <Button
              Grid.Row="0"
              Content="Load"
              Command="{Binding ImageVM.LoadCmd}"
              Margin="4" />

            <Viewbox
                Grid.Row="1"
                Stretch="Uniform"
                Margin="4">
                <Canvas
                    Width="{Binding ImageVM.Current.DisplayBitmap.PixelSize.Width}"
                    Height="{Binding ImageVM.Current.DisplayBitmap.PixelSize.Height}">
                    <Image
                        Source="{Binding ImageVM.Current.DisplayBitmap}"
                        Canvas.Left="0" Canvas.Top="0"
                        Width="{Binding ImageVM.Current.DisplayBitmap.PixelSize.Width}"
                        Height="{Binding ImageVM.Current.DisplayBitmap.PixelSize.Height}" />
                    <Rectangle
                        IsVisible="{Binding IsDefectSelected}"
                        Canvas.Left="{Binding DefectX}"
                        Canvas.Top="{Binding DefectY}"
                        Width="{Binding DefectWidth}"
                        Height="{Binding DefectHeight}"
                        Stroke="Red"
                        StrokeThickness="2" />
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- 우측: Detect 버튼, 결과, 파라미터 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button
              Grid.Row="0"
              Content="Detect"
              Command="{Binding DetectCmd}"
              Margin="4" />

            <views:ResultView
              Grid.Row="1"
              DataContext="{Binding ResultVM}"
              Margin="4" />

            <views:DetailView
              Grid.Row="2"
              DataContext="{Binding ResultVM}"
              Margin="4" />

            <views:ParameterView
              Grid.Row="3"
              DataContext="{Binding ParameterVM}"
              Margin="4" />

        </Grid>
    </Grid>
</Window>
