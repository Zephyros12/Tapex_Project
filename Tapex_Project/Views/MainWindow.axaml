<Window
   x:Class="Tapex_Project.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Tapex_Project.Views"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding Title}"
    Width="1200" Height="800">
    <Grid ColumnDefinitions="2*,1*">
        <views:ImageView   DataContext="{Binding ImageVM}" />
        <Grid Grid.Column="1" RowDefinitions="1*,1*">
            <views:ResultView    DataContext="{Binding ResultVM}"    />
            <views:ParameterView DataContext="{Binding ParameterVM}" />
        </Grid>
    </Grid>
</Window>
