<Window
   x:Class="Tapex_Project.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Tapex_Project.Views"
    xmlns:vm="clr-namespace:Tapex_Project.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding Title}"
    Width="1200" Height="800">
    <Grid ColumnDefinitions="2*,1*">
        <views:ImageView   DataContext="{Binding ImageVM}" />
        
        <Grid Grid.Column="1" RowDefinitions="Auto * Auto">
            <Button Grid.Row="0"
                    Content="Detect"
                    Command="{Binding DetectCmd}"
                    Margin="4"
                    HorizontalAlignment="Stretch"/>
            
            <views:ResultView Grid.Row="1"
                              DataContext="{Binding ResultVM}" />
            
            <views:ParameterView Grid.Row="2" 
                                 DataContext="{Binding ParameterVM}" />
        </Grid>
    </Grid>
</Window>
